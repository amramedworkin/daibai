# DaiBai Configuration Example
# Copy this file to daibai.yaml and fill in your settings

# LLM Provider Configuration
llm:
  # Default provider to use
  default: gemini
  
  providers:
    # Google Gemini
    gemini:
      type: gemini
      model: gemini-2.5-pro
      api_key: ${GEMINI_API_KEY}
      temperature: 0.7
    
    # OpenAI GPT
    openai:
      type: openai
      model: gpt-4o
      api_key: ${OPENAI_API_KEY}
      organization: ${OPENAI_ORG}  # Optional
    
    # Azure OpenAI
    azure:
      type: azure
      deployment: my-gpt4-deployment
      endpoint: https://myresource.openai.azure.com
      api_key: ${AZURE_OPENAI_KEY}
      api_version: "2024-02-01"
    
    # Anthropic Claude
    anthropic:
      type: anthropic
      model: claude-3-5-sonnet-20241022
      api_key: ${ANTHROPIC_API_KEY}
      max_tokens: 4096
    
    # Local Ollama (no API key needed)
    ollama:
      type: ollama
      model: codellama:13b
      host: http://localhost:11434
    
    # Groq (OpenAI-compatible, fast inference)
    groq:
      type: groq
      model: llama-3.1-70b-versatile
      api_key: ${GROQ_API_KEY}
    
    # DeepSeek (OpenAI-compatible)
    deepseek:
      type: deepseek
      model: deepseek-chat
      api_key: ${DEEPSEEK_API_KEY}
    
    # Mistral AI (OpenAI-compatible)
    mistral:
      type: mistral
      model: mistral-large-latest
      api_key: ${MISTRAL_API_KEY}
    
    # Nvidia NIM (Nvidia Inference Microservices)
    nvidia:
      type: nvidia
      model: meta/llama-3.1-70b-instruct-v2
      api_key: ${NVIDIA_API_KEY}
    
    # Alibaba Cloud DashScope (Qwen)
    alibaba:
      type: alibaba
      model: qwen-max
      api_key: ${DASHSCOPE_API_KEY}
      # endpoint: https://dashscope-intl.aliyuncs.com/compatible-mode/v1  # Singapore
      # endpoint: https://dashscope-us.aliyuncs.com/compatible-mode/v1   # Virginia
      # endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1     # Beijing
    
    # Meta Llama (via partner - endpoint required)
    meta:
      type: meta
      model: llama-3.1-70b
      api_key: ${META_API_KEY}
      endpoint: https://your-meta-provider.com/v1  # e.g. Groq, Azure AI, etc.

# Database Configuration
databases:
  # Default database
  default: production
  
  production:
    host: ${DB_PROD_HOST}
    port: 3306
    name: myapp
    user: ${DB_PROD_USER}
    password: ${DB_PROD_PASSWORD}
    ssl: false
  
  staging:
    host: localhost
    port: 3306
    name: staging_db
    user: ${DB_STAGING_USER}
    password: ${DB_STAGING_PASSWORD}
  
  development:
    host: localhost
    port: 3306
    name: dev_db
    user: root
    password: ${DB_DEV_PASSWORD}

  # SuiteCRM example — domain_rules teach DaiBai about application-layer
  # relationships where physical foreign keys do not exist.
  # Each database can have its own rules (or none at all).
  # suitecrm:
  #   host: ${DB_CRM_HOST}
  #   port: 3306
  #   name: suitecrm
  #   user: ${DB_CRM_USER}
  #   password: ${DB_CRM_PASSWORD}
  #   domain_rules: |
  #     SUITECRM SCHEMA RULES:
  #     1. Base tables (e.g., accounts, contacts) rarely join directly.
  #        Use junction tables (e.g., accounts_contacts).
  #     2. Custom fields are in tables ending in '_cstm'.
  #        Join using: base_table.id = custom_table.id_c.
  #     3. Always include 'deleted = 0' for base tables to filter soft-deleted records.
  #     4. The 'id' column is a CHAR(36) UUID, not an integer.

  # MySQL sample databases (load via scripts/mysql_load_sample.py)
  chinook:
    host: ${DB_RUNTIME_HOST:-localhost}
    port: 3306
    name: chinook
    user: ${DB_RUNTIME_USER:-root}
    password: ${DB_RUNTIME_PASSWORD}

  northwind:
    host: ${DB_RUNTIME_HOST:-localhost}
    port: 3306
    name: northwind
    user: ${DB_RUNTIME_USER:-root}
    password: ${DB_RUNTIME_PASSWORD}

# ==========================================
# DOMAIN SPECIFIC RULES (Optional)
# ==========================================
# Use this to teach DaiBai about application-layer relationships (e.g., SuiteCRM, SAP)
# where physical database foreign keys do not exist.
#
# domain_rules: |
#   SUITECRM SCHEMA RULES:
#   1. Base tables (e.g., accounts, contacts) rarely join directly.
#      Use junction tables.
#      Junction tables show joins in their name (example: account_contacts)
#      Preference named junction tables (<primary_table>_<secondary_table>) for joins
#   2. Custom fields are in tables ending in '_cstm'.
#      Join using: base_table.id = custom_table.id_c.
#      <pre>_c fields are custom fields (always).
#   3. Always include 'deleted = 0' for base tables to filter soft-deleted records.
#   4. The 'id' column is a CHAR(36) UUID, not an integer.

# Optional settings
clipboard: true
# Paths support ~ for home directory (e.g. ~/.daibai/exports)
# exports_dir: ~/.daibai/exports
# memory_dir: ~/.daibai/memory
